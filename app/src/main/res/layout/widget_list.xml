<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:textColor="#3B3551" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#F0E9FF" android:padding="8dp" android:textColor="#7052C1" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row1" style="@style/WidgetRow"><TextView android:id="@+id/check1" style="@style/WidgetCheck" /><TextView android:id="@+id/task1" style="@style/WidgetTask" /></LinearLayout>
    <LinearLayout android:id="@+id/row2" style="@style/WidgetRow"><TextView android:id="@+id/check2" style="@style/WidgetCheck" /><TextView android:id="@+id/task2" style="@style/WidgetTask" /></LinearLayout>
    <LinearLayout android:id="@+id/row3" style="@style/WidgetRow"><TextView android:id="@+id/check3" style="@style/WidgetCheck" /><TextView android:id="@+id/task3" style="@style/WidgetTask" /></LinearLayout>
    <LinearLayout android:id="@+id/row4" style="@style/WidgetRow"><TextView android:id="@+id/check4" style="@style/WidgetCheck" /><TextView android:id="@+id/task4" style="@style/WidgetTask" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_more" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="查看全部 ›" android:textColor="#8D73E8" android:textSize="13sp" />
        <TextView android:id="@+id/widget_add" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="＋" android:textColor="#8D73E8" android:textSize="27sp" android:contentDescription="添加任务" />
    </LinearLayout>
</LinearLayout>
