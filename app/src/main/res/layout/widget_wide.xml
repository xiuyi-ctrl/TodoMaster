<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="7dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:orientation="horizontal" android:gravity="center_vertical"><ImageView android:layout_width="27dp" android:layout_height="27dp" android:src="@drawable/ic_cloud_outline" android:contentDescription="咻咿"/><TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:paddingLeft="5dp" android:gravity="center_vertical" android:textColor="#3B3551" android:textSize="16sp" android:textStyle="bold"/><TextView android:id="@+id/widget_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="9dp" android:paddingRight="9dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="#F0E9FF" android:textColor="#8D73E8" android:textSize="11sp"/></LinearLayout>
    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="39dp" android:layout_marginTop="3dp" android:background="@drawable/widget_card" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/check1" android:layout_width="40dp" android:layout_height="39dp" android:gravity="center" android:text="□" android:textColor="#3B3551" android:textSize="22sp"/><LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical"><TextView android:id="@+id/task1" style="@style/WidgetTaskWide"/><TextView android:id="@+id/due1" style="@style/WidgetDueWide"/></LinearLayout></LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="39dp" android:layout_marginTop="3dp" android:background="@drawable/widget_card" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/check2" android:layout_width="40dp" android:layout_height="39dp" android:gravity="center" android:text="□" android:textColor="#3B3551" android:textSize="22sp"/><LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical"><TextView android:id="@+id/task2" style="@style/WidgetTaskWide"/><TextView android:id="@+id/due2" style="@style/WidgetDueWide"/></LinearLayout></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="31dp" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/widget_more" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:paddingLeft="8dp" android:text="查看全部 ›" android:textColor="#8D73E8" android:textSize="12sp"/><TextView android:id="@+id/widget_add" android:layout_width="88dp" android:layout_height="29dp" android:gravity="center" android:background="@drawable/widget_plus" android:text="＋ 新建待办" android:textColor="#FFFFFF" android:textSize="11sp"/></LinearLayout>
</LinearLayout>
