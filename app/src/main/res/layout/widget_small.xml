<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:padding="9dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="29dp" android:orientation="horizontal" android:gravity="center_vertical"><ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_cloud_outline" android:contentDescription="咻咿"/><TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:paddingLeft="5dp" android:textColor="#3B3551" android:textSize="15sp" android:textStyle="bold" android:singleLine="true"/></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/widget_count" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:textColor="#3B3551" android:textSize="28sp" android:textStyle="bold" android:singleLine="true"/><TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingLeft="5dp" android:text="项待完成" android:textColor="#706881" android:textSize="11sp" android:singleLine="true"/></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="10dp" android:background="@drawable/widget_card" android:paddingLeft="10dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:paddingRight="37dp" android:orientation="vertical" android:gravity="center_vertical"><TextView android:id="@+id/widget_task" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#3B3551" android:textSize="13sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end"/><TextView android:id="@+id/widget_due" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:textColor="#706881" android:textSize="11sp" android:singleLine="true" android:ellipsize="end"/></LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_add" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="bottom|right" android:gravity="center" android:background="@drawable/widget_plus" android:text="＋" android:textColor="#FFFFFF" android:textSize="24sp" android:contentDescription="添加任务"/>
</FrameLayout>
